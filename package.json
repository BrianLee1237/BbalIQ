{
  "name": "activetrack-native",
  "version": "0.23.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "doctor": "expo-doctor",
    "build:sites": "expo export --platform web --output-dir dist/client && node scripts/prepare-sites-build.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.9",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "byte-track-ts": "github:billmyplate/byte-track-ts#ac2439c47175307d559daf423c8a8a425abb67bb",
    "expo": "~57.0.18",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.16",
    "expo-file-system": "~57.0.2",
    "expo-haptics": "~57.0.2",
    "expo-image-manipulator": "~57.0.14",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.8",
    "expo-media-library": "~57.0.4",
    "expo-router": "~57.0.17",
    "expo-sharing": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-fast-opencv": "1.0.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-image": "0.15.1",
    "react-native-nitro-modules": "0.36.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-vision-camera": "5.2.2",
    "react-native-vision-camera-resizer": "5.2.2",
    "react-native-vision-camera-skia": "5.2.2",
    "react-native-vision-camera-worklets": "5.2.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "react-native-worklets-core": "1.6.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "^1.20.1",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nitro-image"
        ]
      }
    }
  },
  "allowScripts": {
    "@shopify/react-native-skia@2.6.2": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
